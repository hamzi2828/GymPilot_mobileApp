# Where the app talks to. Copy this file to .env and set the address.
#
# A phone cannot reach "localhost" -- that is the phone itself -- so for
# development use your machine's address on the wifi, which Expo prints when
# you run `npm start` (e.g. http://192.168.1.20:4000).
#
# In production this is your GymPilot backend, over https.
EXPO_PUBLIC_API_URL=http://localhost:4000
